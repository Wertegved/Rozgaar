APP_NAME=Rozgaar API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_DIRECT_URL=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Development-only Admin bootstrap inputs. Keep empty outside local setup.
DEV_ADMIN_NAME=Development Admin
DEV_ADMIN_EMAIL=demo.admin.8e33087c@example.com
DEV_ADMIN_PHONE=+910000000001
DEV_ADMIN_PASSWORD=DemoAdmin123!
PAYMENT_PROVIDER=simulated
PAYMENT_ADVANCE_PERCENTAGE=20

EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Rozgaar

# Local development only. Use managed Redis URLs in deployed environments.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI providers. Keep keys empty locally unless making an explicit live request.
AI_PRIMARY_PROVIDER=groq
AI_PRIMARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_API_KEY=
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Supabase Realtime uses the existing PostgreSQL publication.
REALTIME_ENABLED=true
REALTIME_PUBLICATION=supabase_realtime
